# NexRL compiled config — generated by summit from a summit.yaml. Do not edit.
# Self-hosted OPD, single machine, remote teacher (Fireworks echo logprobs).

project_name: "{{ project_name }}"
experiment_name: "{{ experiment_name }}"

launch_mode: "local"
multi_model: "false"

logger:
  backend: {{ logger_backends }}
  enable_feishu_logging: false

resume:
  mode: disable
  resume_path: ""
  resume_dataloader: true

data:
  type: "torch"
  seed: 42
  data_files:
    - "${oc.env:NEXRL_DATA_PATH}/deepswe/train.parquet"
  batch_size: {{ batch_size }}
  keep_batch_order: true
  rollout_repeat_n: {{ rollout_repeat_n }}
  prompt_key: "prompt"
  filter_prompts: false
  max_prompt_length: {{ max_prompt_length }}
  max_response_length: ${rollout_worker.max_response_length}
  tokenizer_path: "{{ student_model }}"
  shuffle: {{ shuffle | lower }}
  drop_last: false

rollout_worker:
  type: "deepswe"
  custom_rollout_worker_module_path: "${oc.env:SUMMIT_REPO_DIR}/summit/rollout/deepswe_worker.py"
  custom_rollout_worker_class_name: "DeepSWERolloutWorker"
  sandbox: "{{ sandbox }}"
  step_limit: {{ step_limit }}
  num_workers: {{ num_workers }}
  need_llm_inference: true
  temperature: {{ temperature }}
  max_prompt_length: ${data.max_prompt_length}
  max_response_length: {{ max_response_length }}
  max_sequence_length: {{ max_sequence_length }}

trajectory_pool:
  type: "default"
  batch_size: ${data.batch_size}
  group_size: 1
  key_list: []
  # keep_batch_order:true (required by sync_mode:sync) forces the loaded-batch
  # gate here too; the pool then drains ALL finished trajectories (the whole
  # loaded batch) into one training batch — memory is bound via the seq-length
  # cap set in the summit config (max_sequence_length).
  check_batch_ready_function: "batch_size_reached_and_loaded_batch_finished"

trainer:
  type: "self_hosted_opd"
  custom_trainer_module_path: "${oc.env:SUMMIT_REPO_DIR}/summit/nexrl_ext/opd_trainer.py"
  custom_trainer_class_name: "SummitOpdTrainer"

  use_distillation_clipping: false
  distillation_cliprange: 0.2
  distillation_cliprange_low: 0.2
  distillation_cliprange_high: 0.2
  do_old_student_log_prob_compute: false
  train_token_start_pct: 0.0
  train_token_end_pct: 1.0
  advantage_start_pct: 0.0
  advantage_end_pct: 1.0

  algorithm:
    type: "distillation"
    distillation_coeff: {{ distillation_coeff }}
    entropy_coeff: {{ entropy_coeff }}
    temperature: ${rollout_worker.temperature}
    loss_agg_mode: "token-mean"
    distillation_epochs: 1
    use_distillation_clipping: ${trainer.use_distillation_clipping}
    distillation_cliprange: ${trainer.distillation_cliprange}
    distillation_cliprange_low: ${trainer.distillation_cliprange_low}
    distillation_cliprange_high: ${trainer.distillation_cliprange_high}
    do_old_student_log_prob_compute: ${trainer.do_old_student_log_prob_compute}
    train_token_start_pct: ${trainer.train_token_start_pct}
    train_token_end_pct: ${trainer.train_token_end_pct}
    advantage_start_pct: ${trainer.advantage_start_pct}
    advantage_end_pct: ${trainer.advantage_end_pct}

  total_train_steps: {{ total_train_steps }}
  save_freq: {{ save_freq }}
  checkpoint_path: "${oc.env:EXPERIMENT_PATH}/ckpt"
  sync_weight_path: "${oc.env:EXPERIMENT_PATH}/sync_weight"
  remove_previous_ckpt: false

weight:
  type: "default"
  sync_mode: "sync"
  staleness_threshold: 0
  sync_method: "disk"  # "network" needs the internal north_checkpoint package; disk fits single-VM
  sync_weight_path: ${trainer.sync_weight_path}
  validate_freq: ${validate.eval.validate_freq}

validate:
  validate_before_train: false
  max_response_length: {{ max_response_length }}
  data:
    type: "torch"
    seed: ${data.seed}
    data_files:
      - "${oc.env:NEXRL_DATA_PATH}/deepswe/train.parquet"
    batch_size: 4
    prompt_key: "prompt"
    filter_prompts: false
    max_prompt_length: ${data.max_prompt_length}
    tokenizer_path: ${data.tokenizer_path}
    shuffle: false
    drop_last: false
  eval:
    type: "default"
    validate_freq: 1000000  # effectively off for the v0.1 smoke run

service:
  inference_service:
    identifier: "student"
    api_key: "EMPTY"
    base_url: "http://${oc.env:INFERENCE_BASE_URL}"
    model: "{{ served_model_name }}"
    model_path: "{{ student_model }}"
    max_tokens: ${data.max_response_length}
    tokenizer: "{{ student_model }}"
    backend: sglang
    max_retries: 3
    freeze_for_weight_sync: true
    weight_type: "sglang_nckpt"
    resource:
      backend: sglang
      replicas: 1
      gpus_per_replica: {{ rollout_gpus }}
      extra_args: ""

  train_service:
    student:
      identifier: "student"
      role: "actor"
      backend: http
      url: "http://${oc.env:API_SERVER_URL}:8000"
      resource:
        world_size: 1
        gpus_per_pod: {{ train_gpus }}
        memory_per_gpu: 200
      actor:
        checkpoint_manager: dcp
        model:
          path: "{{ student_model }}"
          use_remove_padding: false  # avoid flash-attn build requirement for v0.1
          enable_gradient_checkpointing: {{ memory_efficient_fsdp | lower }}
        # Accumulate turn-level trajectories before each optimizer step. NexRL
        # floor-divides both values by the DP world size; the rendered mini
        # batch is therefore also guaranteed to be at least train_gpus.
        ppo_mini_batch_size: {{ ppo_mini_batch_size }}
        ppo_micro_batch_size: {{ train_gpus }}
        grad_clip: 1.0
        clip_ratio: 0.2
        clip_ratio_low: 0.2
        clip_ratio_high: 0.2
        clip_ratio_c: 3.0
        use_distillation_clipping: ${trainer.use_distillation_clipping}
        distillation_cliprange: ${trainer.distillation_cliprange}
        distillation_cliprange_low: ${trainer.distillation_cliprange_low}
        distillation_cliprange_high: ${trainer.distillation_cliprange_high}
        do_old_student_log_prob_compute: ${trainer.do_old_student_log_prob_compute}
        train_token_start_pct: ${trainer.train_token_start_pct}
        train_token_end_pct: ${trainer.train_token_end_pct}
        advantage_start_pct: ${trainer.advantage_start_pct}
        advantage_end_pct: ${trainer.advantage_end_pct}
        loss_agg_mode: token-mean
        loss_func_type: NX_20250515
        entropy_coeff: ${trainer.algorithm.entropy_coeff}
        use_kl_loss: false
        kl_loss_type: low_var_kl
        kl_loss_coef: 0.0
        use_ring_sequence_parallel: false
        ppo_epochs: ${trainer.algorithm.distillation_epochs}
        ulysses_sequence_parallel_size: 1
        use_dynamic_bsz: false
        # bound per-GPU activation peak to the (already-capped) seq length
        ppo_max_token_len_per_gpu: {{ max_sequence_length }}
        do_old_log_prob_compute: false
        optim:
          lr: {{ "%.10f" | format(learning_rate) }}
          lr_warmup_steps_ratio: 0.0
          warmup_style: constant
        fsdp_config:
          wrap_policy:
            min_num_params: 0
          model_dtype: bfloat16  # fp32 default OOMs full-FT on small fleets
{% if memory_efficient_fsdp %}
          mixed_precision:
            param_dtype: bf16
            reduce_dtype: bf16
            buffer_dtype: bf16
{% endif %}
          param_offload: {{ offload }}
          grad_offload: false
          optimizer_offload: {{ offload }}
          fsdp_size: -1
        ref:
          fsdp_config:
            param_offload: true
            wrap_policy:
              min_num_params: 0
          # per-GPU = value // DP size; pin to train_gpus so per-GPU = 1
          log_prob_micro_batch_size: {{ train_gpus }}
          ulysses_sequence_parallel_size: 1
        rollout:
          rollout_standalone: true
          temperature: ${rollout_worker.temperature}
          use_distillation_clipping: ${trainer.algorithm.use_distillation_clipping}
          distillation_cliprange: ${trainer.algorithm.distillation_cliprange}
          distillation_cliprange_low: ${trainer.algorithm.distillation_cliprange_low}
          distillation_cliprange_high: ${trainer.algorithm.distillation_cliprange_high}
          do_old_student_log_prob_compute: ${trainer.algorithm.do_old_student_log_prob_compute}
          train_token_start_pct: ${trainer.algorithm.train_token_start_pct}
          train_token_end_pct: ${trainer.algorithm.train_token_end_pct}
          advantage_start_pct: ${trainer.algorithm.advantage_start_pct}
          advantage_end_pct: ${trainer.algorithm.advantage_end_pct}
          dtype: bfloat16
          tensor_model_parallel_size: {{ rollout_gpus }}
          # per-GPU = value // DP size; pin to train_gpus so per-GPU = 1
          log_prob_micro_batch_size: {{ train_gpus }}
          n: ${data.rollout_repeat_n}
          # weight_provider needs the internal north_checkpoint package; disk
          # sync_method (above) is the open-source path on a single VM.
          use_weight_provider: false

    # Remote teacher (Fireworks echo logprobs). The SummitOpdTrainer subclass
    # reads backend/url/identifier only; workers are never launched.
    teacher:
      identifier: "teacher"
      role: "teacher"
      model_path: "{{ teacher_model }}"
      backend: fireworks
      url: "{{ teacher_base_url }}"
      resource:
        # world_size/gpus_per_pod are required by the parent trainer's __init__
        # and used for teacher-batch padding (pad_to_world_size). 1x1 = no-op
        # padding; no workers are ever launched for a remote backend.
        world_size: 1
        gpus_per_pod: 1
        memory_per_gpu: 0
      actor:
        checkpoint_manager: dcp
        model:
          path: "{{ teacher_model }}"
        ppo_mini_batch_size: ${data.batch_size}
        ppo_micro_batch_size: 1
        optim:
          lr: {{ "%.10f" | format(learning_rate) }}
        rollout:
          rollout_standalone: true
          tensor_model_parallel_size: 1
          n: 1

runtime_monitor:
  exception_handling:
    enabled: true
    check_interval: 1.0
    policy: "stop_on_error"
  health_check:
    enabled: true
    check_interval: 10.0
    timeout: 5.0
